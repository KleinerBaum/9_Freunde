# Zero-secret local demo. Never use demo accounts with real child data.
DATA_MODE=demo
REAL_DATA_APPROVED=false
AUTH_MODE=password
SESSION_SECRET=replace-with-at-least-32-random-characters
AUDIT_HASH_SECRET=replace-with-an-independent-random-secret
APP_BASE_URL=http://localhost:3000

# Production access. The portal reads users from the `users` sheet.
# DATA_MODE=google
# REAL_DATA_APPROVED=true
# AUTH_MODE=sites
# MANAGED_STAFF_EMAIL_DOMAIN=example.org
# PARENT_ACCESS_ENABLED=false
# MCP_ENABLED=false
# ADMIN_EMAILS=leitung@example.org
# MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Public controller and privacy-contact information.
# PRIVACY_CONTROLLER_NAME=Example Childcare Provider e.V.
# PRIVACY_CONTROLLER_ADDRESS=Example Street 1, 40200 Düsseldorf
# PRIVACY_CONTACT_EMAIL=datenschutz@example.org
# PRIVACY_DPO_EMAIL=dsb@example.org
# LEGAL_REPRESENTATIVE=Firstname Lastname
# LEGAL_REGISTER=Register court and registration number
# LEGAL_SUPERVISORY_AUTHORITY=Competent supervisory authority

# Google service account and resource configuration.
# GOOGLE_WORKSPACE_DOMAIN=example.org
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example-project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEET_ID=replace-with-spreadsheet-id
# GOOGLE_DRIVE_PHOTOS_FOLDER_ID=replace-with-private-folder-id
# GOOGLE_CALENDAR_ID=replace-with-calendar-id
# Required for Calendar attendee invitations in Google Workspace. The service
# account must have domain-wide delegation for calendar.events and impersonates
# this dedicated organizer account only for Calendar calls.
# GOOGLE_CALENDAR_IMPERSONATED_USER_EMAIL=portal-calendar@example.org

# Optional sheet tab overrides.
# GOOGLE_CHILDREN_TAB=children
# GOOGLE_PARENTS_TAB=parents
# GOOGLE_USERS_TAB=users
# GOOGLE_DOCUMENTS_TAB=documents
# GOOGLE_CONSENTS_TAB=consents
# GOOGLE_AUDIT_TAB=audit
# GOOGLE_PRIVACY_REQUESTS_TAB=privacy_requests
